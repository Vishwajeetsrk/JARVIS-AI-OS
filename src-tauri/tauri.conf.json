{
  "$schema": "https://raw.githubusercontent.com/nicokosi/tauri-v2-schema/main/json/tauri-v2.schema.json",
  "productName": "Jarvis AI OS",
  "version": "2.7.0",
  "identifier": "com.jarvisaios.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8080",
    "frontendDist": "https://jarvisaios.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nia AI Companion",
        "url": "/companion",
        "width": 380,
        "height": 580,
        "minWidth": 260,
        "minHeight": 380,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libgtk-3-0", "libwebkit2gtk-4.1-0", "libappindicator3-dev", "librsvg2-dev", "patchelf"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "mobile": [
        { "host": "jarvisaios.app", "pathPrefix": ["/"] }
      ],
      "desktop": {
        "schemes": ["jarvis"]
      }
    },
    "notification": {
      "enabled": true
    },
    "autostart": {
      "enabled": true
    },
    "window-state": {
      "enabled": true
    }
  }
}
