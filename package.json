{
  "name": "vishwajeet-ai-os",
  "version": "2.0.0",
  "description": "JARVIS AI OS — Persistent-memory AI Operating System with 30 agents, 150 design systems, and 68 open-source repos",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "dev:mastra": "tsx watch src/mastra/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "jarvis": "tsx scripts/jarvis.ts",
    "jarvis:status": "tsx scripts/jarvis.ts status",
    "bridge": "python scripts/desktop-voice-bridge.py",
    "bridge:system": "python scripts/desktop-voice-bridge.py system",
    "bridge:screenshot": "python scripts/desktop-voice-bridge.py screenshot",
    "bridge:launch": "python scripts/desktop-voice-bridge.py launch",
    "daemon": "tsx src/daemon/server.ts",
    "daemon:dev": "tsx watch src/daemon/server.ts",
    "dev:with-daemon": "concurrently \"npm run dev\" \"npm run daemon\"",
    "dev:all": "concurrently \"npm run dev\" \"npm run daemon\" \"npm run dev:mastra\"",
    "postinstall": "node scripts/patch-vite-runner.mjs"
  },
  "keywords": [
    "ai-os",
    "multi-agent",
    "mastra",
    "jarvis",
    "agent-skills"
  ],
  "author": "Vishwajeet",
  "license": "MIT",
